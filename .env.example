# ==============================================================================
# Director by IAM-Studio — Variables de Entorno
# Copia este archivo a .env y rellena los valores reales.
# ⚠️  NUNCA subas .env al repositorio — está en .gitignore
# ==============================================================================

# ─── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_DB=director_db
POSTGRES_USER=director_user
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_SEGURA

DATABASE_URL=postgresql+asyncpg://director_user:CAMBIA_ESTA_CONTRASENA_SEGURA@db:5432/director_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CAMBIA_REDIS_PASSWORD
REDIS_URL=redis://:CAMBIA_REDIS_PASSWORD@cache:6379/0

# ─── JWT / Seguridad ──────────────────────────────────────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERA_CON_COMANDO_ARRIBA_32_CHARS_MIN

# ─── OAuth2 — Google ──────────────────────────────────────────────────────────
# Crea en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# ─── OAuth2 — GitHub ──────────────────────────────────────────────────────────
# Crea en: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=tu-github-client-id
GITHUB_CLIENT_SECRET=tu-github-client-secret

# ─── URLs ─────────────────────────────────────────────────────────────────────
# El dominio donde estará la app (sin trailing slash)
FRONTEND_URL=http://72.62.202.41:8080
VITE_API_URL=/api
